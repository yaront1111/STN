# Service to reset navigation estimate to a known pose
# Used for manual initialization or recovery

# Request
geometry_msgs/PoseWithCovariance initial_pose  # Initial pose estimate
bool reset_velocity                            # Whether to reset velocity to zero
bool reset_map                                 # Whether to clear accumulated map
---
# Response
bool success                                   # Whether reset was successful
string message                                 # Status or error message
builtin_interfaces/Time reset_time            # Timestamp of reset
